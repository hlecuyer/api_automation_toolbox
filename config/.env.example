# ============================================
# CREDENTIALS - Données sensibles uniquement
# ============================================
# Ne mettez que les credentials ici, le reste va dans le fichier JSON

# HelloAsso API Credentials
HELLOASSO_CLIENT_ID=your_client_id_here
HELLOASSO_CLIENT_SECRET=your_client_secret_here

# OVH API Credentials
OVH_ENDPOINT=ovh-eu
OVH_APP_KEY=your_ovh_app_key
OVH_APP_SECRET=your_ovh_app_secret
OVH_CONSUMER_KEY=your_ovh_consumer_key

# Airtable API Credentials
AIRTABLE_API_KEY=your_airtable_api_key_or_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id

# ============================================
# SIGNATURE des mails sortants
# ============================================
# Données personnelles : elles ne doivent jamais être écrites en dur dans le code,
# ce dépôt est public. Sans ces variables, les mails partent avec une signature
# institutionnelle et un avertissement est écrit dans syslog.
SIGNATURE_NAME=Prénom NOM
SIGNATURE_ROLE=Fonction
SIGNATURE_PHONE=+33 (0)0 00 00 00 00
SIGNATURE_EMAIL=prenom.nom@votre-domaine.org
